{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["esnext"],
    "types": ["bun-types"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "../lib/**/*.ts", "../drizzle/**/*.ts"]
}
